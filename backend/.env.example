# Telegram API credentials from https://my.telegram.org (server only)
API_ID=
API_HASH=

# Private channel ID containing test videos (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=

# Begin with one bot token for a personal proof of concept; add it as channel admin.
# Never put this token in Android, source control, chat messages, or public logs.
BOT_TOKEN_1=

# Required for POST /api/scan. Generate a long random value and keep it server-side.
ADMIN_API_KEY=

# Optional metadata enrichment. Playback should work without TMDb.
TMDB_API_KEY=

SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./cinestream.db
START_TELEGRAM_POOL=false
SYNC_IPTV_ON_STARTUP=false
SYNC_EPG_ON_STARTUP=false
