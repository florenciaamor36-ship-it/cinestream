# ==============================================================================
# CineStream Backend - Variables de Entorno y Configuración de los 20 Bots
# ==============================================================================

# Credenciales de la API de Telegram (Obtenidas en https://my.telegram.org)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# ID del canal o supergrupo privado donde se almacenan los videos (ej. -1001234567890)
# Los 20 bots deben ser añadidos como administradores en este canal con permisos de lectura.
TELEGRAM_CHANNEL_ID=-1001987654321

# Granja de 20 Bots de Telegram (Worker Pool)
# Crea 20 bots a través de @BotFather y pega sus tokens aquí:
BOT_TOKEN_1=1111111111:AAHxxxx_Bot1TokenSamplexxxxxxxxxx
BOT_TOKEN_2=2222222222:AAHxxxx_Bot2TokenSamplexxxxxxxxxx
BOT_TOKEN_3=3333333333:AAHxxxx_Bot3TokenSamplexxxxxxxxxx
BOT_TOKEN_4=4444444444:AAHxxxx_Bot4TokenSamplexxxxxxxxxx
BOT_TOKEN_5=5555555555:AAHxxxx_Bot5TokenSamplexxxxxxxxxx
BOT_TOKEN_6=6666666666:AAHxxxx_Bot6TokenSamplexxxxxxxxxx
BOT_TOKEN_7=7777777777:AAHxxxx_Bot7TokenSamplexxxxxxxxxx
BOT_TOKEN_8=8888888888:AAHxxxx_Bot8TokenSamplexxxxxxxxxx
BOT_TOKEN_9=9999999999:AAHxxxx_Bot9TokenSamplexxxxxxxxxx
BOT_TOKEN_10=1010101010:AAHxxxx_Bot10TokenSamplexxxxxxxxx
BOT_TOKEN_11=1111111112:AAHxxxx_Bot11TokenSamplexxxxxxxxx
BOT_TOKEN_12=1212121212:AAHxxxx_Bot12TokenSamplexxxxxxxxx
BOT_TOKEN_13=1313131313:AAHxxxx_Bot13TokenSamplexxxxxxxxx
BOT_TOKEN_14=1414141414:AAHxxxx_Bot14TokenSamplexxxxxxxxx
BOT_TOKEN_15=1515151515:AAHxxxx_Bot15TokenSamplexxxxxxxxx
BOT_TOKEN_16=1616161616:AAHxxxx_Bot16TokenSamplexxxxxxxxx
BOT_TOKEN_17=1717171717:AAHxxxx_Bot17TokenSamplexxxxxxxxx
BOT_TOKEN_18=1818181818:AAHxxxx_Bot18TokenSamplexxxxxxxxx
BOT_TOKEN_19=1919191919:AAHxxxx_Bot19TokenSamplexxxxxxxxx
BOT_TOKEN_20=2020202020:AAHxxxx_Bot20TokenSamplexxxxxxxxx

# Credenciales de TMDb (The Movie Database) para enriquecer metadata automáticamente
TMDB_API_KEY=tu_clave_api_tmdb_aqui

# Configuración del Servidor HTTP Streaming
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=cinestream_super_secret_stream_token_2026

# Configuración de Base de Datos (SQLite por defecto o PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./cinestream.db
# Para PostgreSQL: postgresql+asyncpg://usuario:contraseña@localhost:5432/cinestream

# Opcional: Proxy SOCKS5/MTProto para evitar bloqueos por IP de Telegram en el VPS
# PROXY_SCHEME=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
